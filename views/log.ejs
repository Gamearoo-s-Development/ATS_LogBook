<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>DOT Logbook (Game Time)</title>
  <link rel="stylesheet" href="/public/styles.css">
</head>
<body>
  <header class="topbar">
    <div class="brand">DOT Logbook — Game Time</div>
    <nav class="nav"><a href="/settings">Settings</a></nav>
  </header>

  <!-- Centered alerts -->
  <div id="conn-alert" class="center-alert hidden">⚠️ Not connected to game (telemetry unreachable or game closed).</div>
  <div id="paused-alert" class="center-alert hidden">⏸ Game is paused.</div>

  <main class="container">
    <!-- Summary cards -->
    <section class="row">
      <div class="card">
        <div class="card-title">Driver</div>
        <div class="card-value"><%= settings.driver_name %></div>
      </div>

      <div class="card">
        <div class="card-title">Telemetry</div>
        <div class="card-kv"><span>Connected:</span><span id="telemetry-connected" class="kv-value"><%= (telem && telem.game && telem.game.connected) ? "Yes" : "No" %></span></div>
        <div class="card-kv"><span>Game:</span><span id="telemetry-game"><%= telem && telem.game && telem.game.gameName ? telem.game.gameName : "—" %></span></div>
        <div class="card-kv"><span>Paused:</span>
          <span id="telemetry-paused">
            <%= (telem && telem.game && typeof telem.game.paused === "boolean") ? (telem.game.paused ? "Yes" : "No") : "—" %>
          </span>
        </div>
        <div class="card-kv"><span>Time Scale:</span><span id="telemetry-timescale"><%= telem && telem.game && (telem.game.timeScale ?? null) !== null ? telem.game.timeScale : "—" %></span></div>
      </div>

      <div class="card">
        <div class="card-title">Game Time</div>
        <%
          // ISO → "h:mm AM/PM"
          function fmt12(iso) {
            if (!iso || iso.length < 16) return "—";
            const hh = Number(iso.slice(11,13));
            const mm = iso.slice(14,16);
            const ampm = hh >= 12 ? "PM" : "AM";
            const h12 = ((hh % 12) || 12);
            return `${h12}:${mm} ${ampm}`;
          }
          const gt = telem && telem.game ? telem.game.time : null;
          const dateStr = gt ? gt.slice(0,10) : "—";
        %>
        <div id="game-time">
          <div class="card-kv"><span>Date:</span><span id="game-date"><%= dateStr %></span></div>
          <div class="card-kv"><span>Time:</span><span id="game-time-text"><%= gt ? fmt12(gt) : "—" %></span></div>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Truck</div>
        <%
          const kmh = telem && telem.truck && typeof telem.truck.speed === "number" ? telem.truck.speed : null;
          const mph = kmh === null ? null : (kmh * 0.621371);
          const odoKm = telem && telem.truck && typeof telem.truck.odometer === "number" ? telem.truck.odometer : null;
          const odoMi = odoKm === null ? null : (odoKm * 0.621371);
        %>
        <div class="card-kv"><span>Speed:</span><span id="truck-speed"><%= mph === null ? "—" : mph.toFixed(0) + " mph" %></span></div>
        <div class="card-kv"><span>Odometer:</span><span id="truck-odo"><%= odoMi === null ? "—" : odoMi.toFixed(0) + " mi" %></span></div>
      </div>
    </section>

    <!-- Day navigation + calendar -->
    <section class="row">
      <div class="card wide">
        <div class="card-title">Day</div>
        <% if (gameDate) { %>
          <div class="card-kv"><span>Viewing Game Date:</span><span><%= gameDate %></span></div>
        <% } else { %>
          <div class="card-value warn">No game date. Start the game with telemetry to pick a day.</div>
        <% } %>
        <div class="day-nav">
          <% if (gameDate) { 
               const d0 = new Date(gameDate + "T00:00:00Z");
               const dPrev = new Date(d0.getTime() - 24*60*60*1000).toISOString().slice(0,10);
               const dNext = new Date(d0.getTime() + 24*60*60*1000).toISOString().slice(0,10);
          %>
            <a class="btn" href="/log/<%= dPrev %>">◀ Prev Day</a>
            <a class="btn" href="/">Today (Game)</a>
            <a class="btn" href="/log/<%= dNext %>">Next Day ▶</a>
            <input id="date-picker" class="date-input" type="date" value="<%= gameDate %>">
          <% } %>
        </div>
      </div>
    </section>

    <!-- Quick Log -->
    <section class="row">
      <div class="card wide quick-log">
        <div class="card-title">Quick Log (stamps current <em>game time</em>)</div>

        <!-- Big current status (spelled out) -->
        <%
          const labelOf = s => ({OFF:"Off Duty", SB:"Sleeper", D:"Driving", ON:"On Duty", YM:"Yard Move", PC:"Personal Conveyance"})[s] || s || "Off Duty";
        %>
        <div class="current-status">
          <span class="status-chip <%= (currentStatus||'OFF').toLowerCase() %>">
            <%= labelOf(currentStatus || 'OFF') %>
          </span>
        </div>

        <div class="status-buttons">
          <button class="status off <%= currentStatus==='OFF' ? 'active' : '' %>" data-status="OFF">Off Duty</button>
          <button class="status sb  <%= currentStatus==='SB'  ? 'active' : '' %>" data-status="SB">Sleeper</button>
          <button class="status d   <%= currentStatus==='D'   ? 'active' : '' %>" data-status="D">Driving</button>
          <button class="status on  <%= currentStatus==='ON'  ? 'active' : '' %>" data-status="ON">On Duty</button>
          <button class="status ym  <%= currentStatus==='YM'  ? 'active' : '' %>" data-status="YM">Yard Move</button>
          <button class="status pc  <%= currentStatus==='PC'  ? 'active' : '' %>" data-status="PC">Personal Conveyance</button>
        </div>

        <div class="quick-form">
          <label class="qf-item">
            <span>Activity</span>
            <select id="activity" class="activity-select">
              <option value="">—</option>
              <option>Fuel</option>
              <option>Pre/Post Trip</option>
              <option>Live Load/Unload</option>
              <option>Scale</option>
              <option>Breakdown</option>
              <option>Wash</option>
              <option>Paperwork</option>
            </select>
          </label>

          <label class="qf-item qf-wide">
            <span>Location (City, State — auto; you can edit)</span>
            <input id="location" type="text" placeholder="City, State" value="<%= initialLoc || '' %>">
          </label>
        </div>

        <div id="post-result" class="muted"></div>
      </div>
    </section>

    <!-- DOT-style Daily Grid (AM/PM axis; PC on OFF row; YM on ON row; future trimmed) -->
    <section class="row">
      <div class="card wide">
        <div class="card-title">Daily Grid (Game Date)</div>

        <% if (gameDate) { %>
          <% 
            const fmtDur = (m)=>{ const h=Math.floor(m/60); const mm=String(m%60).padStart(2,'0'); return `${h}:${mm}`; };
            const dOFF = durations.OFF||0, dSB = durations.SB||0, dD = durations.D||0, dON = durations.ON||0;
            function hourLabel12(h){ const am=(h<12||h===24); const raw=h%12; const h12=raw===0?12:raw; return `${h12} ${am?'AM':'PM'}`; }
          %>

          <div class="grid" style="--graph-height:160px; --y-off:20px; --y-sb:60px; --y-d:100px; --y-on:140px; --label-nudge:20px;">
            <div class="grid-y"><div>OFF</div><div>SB</div><div>D</div><div>ON</div></div>

            <div class="grid-x">
              <% for (let h=0; h<25; h++) { %>
                <div class="tick"><%= hourLabel12(h) %></div>
              <% } %>
            </div>

            <div class="grid-lines">
              <% for (let h=0; h<25; h++){ const leftPct=(h/24)*100; %>
                <div class="vline" style="left:<%= leftPct %>%"></div>
              <% } %>
              <div class="hline" style="top:var(--y-off)"></div>
              <div class="hline" style="top:var(--y-sb)"></div>
              <div class="hline" style="top:var(--y-d)"></div>
              <div class="hline" style="top:var(--y-on)"></div>
            </div>

            <div class="grid-bars">
              <%
                const rowOf = s => (s==="OFF" ? 0 : s==="SB" ? 1 : s==="D" ? 2 : (s==="PC" ? 0 : 3));
                const D0 = new Date(gameDate + "T00:00:00Z").getTime();
                function minSinceMid(iso){ const t=new Date(iso).getTime(); return Math.max(0, Math.min(1440, Math.floor((t-D0)/60000))); }
              %>
              <% segments.forEach(seg=>{ 
                   const m0=minSinceMid(seg.startIso), m1=minSinceMid(seg.endIso), mins=Math.max(0,m1-m0);
                   const leftPct=(m0/1440)*100, widthPct=(mins/1440)*100, row=rowOf(seg.status);
              %>
                <div class="bar row-<%= row %> <%= seg.status.toLowerCase() %>" style="left:<%= leftPct %>%; width:<%= widthPct %>%;">
                  <span class="bar-label"><%= seg.status %></span>
                </div>
              <% }); %>
            </div>

            <div class="grid-durations">
              <div class="dur off" style="top:var(--y-off)">
                <%= fmtDur(dOFF) %>
                <% if ((durations.PC||0)>0){ %><span class="dur-sub">PC <%= fmtDur(durations.PC) %></span><% } %>
              </div>
              <div class="dur sb"  style="top:var(--y-sb)"><%= fmtDur(dSB) %></div>
              <div class="dur d"   style="top:var(--y-d)"><%= fmtDur(dD) %></div>
              <div class="dur on"  style="top:var(--y-on)">
                <%= fmtDur(dON) %>
                <% if ((durations.YM||0)>0){ %><span class="dur-sub">YM <%= fmtDur(durations.YM) %></span><% } %>
              </div>
            </div>
          </div>
        <% } else { %>
          <div class="muted">Start your game / telemetry to view a day.</div>
        <% } %>
      </div>
    </section>

    <!-- Event list (AM/PM time + Activity + Location) -->
    <section class="row">
      <div class="card wide">
        <div class="card-title">Events on <%= gameDate || "?" %></div>
        <% if (events.length === 0) { %>
          <div class="muted">No events for this date yet.</div>
        <% } else { %>
          <table class="events">
            <thead>
              <tr>
                <th>Time</th><th>Status</th><th>Activity</th><th>Location</th><th>Odometer</th>
              </tr>
            </thead>
            <tbody>
              <% 
                const fmt12 = (iso) => {
                  if (!iso || iso.length < 16) return "—";
                  const hh = Number(iso.slice(11,13));
                  const mm = iso.slice(14,16);
                  const ampm = hh >= 12 ? "PM" : "AM";
                  const h12 = ((hh % 12) || 12);
                  return `${h12}:${mm} ${ampm}`;
                };
                events.forEach(ev => { 
                  const t = fmt12(ev.gameTimeIso);
                  const odo = (typeof ev.odometerMi==="number") ? `${ev.odometerMi.toFixed(0)} mi` : "—";
              %>
                <tr>
                  <td><%= t %></td>
                  <td><%= ev.status %></td>
                  <td><%= ev.activity || "" %></td>
                  <td><%= ev.location || "" %></td>
                  <td><%= odo %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>
  </main>

  <footer class="footer"><div>Game Time only. Telemetry-driven. No IRL time or clocks are used.</div></footer>
  <script src="/public/main.js"></script>
</body>
</html>
